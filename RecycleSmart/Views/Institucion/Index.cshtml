@model List<RecycleSmartBE.InstitucionCliente>

@{
    ViewData["Title"] = "Instituciones cliente";
    int usadas = ViewBag.Usadas ?? 0;
    int maximo = ViewBag.Maximo ?? 0;
    bool ilimitado = maximo == 0;
    bool limiteAlcanzado = !ilimitado && usadas >= maximo;
}

<h2 class="mb-0">Instituciones cliente</h2>
<p class="text-muted mb-3">
    @if (ilimitado)
    {
        <span>@usadas instituciones · plan ilimitado</span>
    }
    else
    {
        <span>@usadas de @maximo instituciones de su plan</span>
        @if (limiteAlcanzado)
        {
            <span class="text-danger fw-semibold"> · Límite alcanzado</span>
        }
    }
</p>

<partial name="_Mensajes" />

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay instituciones registradas.</div>
}
else
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-success">
                    <tr>
                        <th>Nombre</th>
                        <th>Direccion</th>
                        <th>Tipo</th>
                        <th>CUIT</th>
                        <th>Contenedores</th>
                        <th>Contenedores</th>
                        <th>Tarjetas</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        var estado = i.Estados.ToString();
                        <tr>
                            <td>@i.Nombre</td>
                            <td>@i.Direccion</td>
                            <td>@i.Tipo</td>
                            <td>@FormatoEtiqueta.CUIT(i.Cuit)</td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary">
                                    Ver Contenedores
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Contenedor" asp-action="Index" asp-route-institucionId="@i.Id"
                                   class="btn btn-sm btn-outline-success">
                                    <i class='bx bx-box'></i> @i.CantidadContenedores
                                </a>
                            </td>
                            <td>
                                <a class ="btn btn-sm btn-outline-secondary">
                                    Ver Tarjetas
                                </a> 
                            </td>
                            <td><span class="badge @EstadosColor.EstadoBadge(estado)">@estado</span></td>
                            <td class="text-center">
                                <a asp-action="Detalle" asp-route-id="@i.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class='bx bx-show'></i> Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<div class="d-flex justify-content-between align-items-center mt-3">
    @if (limiteAlcanzado)
    {
        <button class="btn btn-success" disabled title="Alcanzó el límite de su plan">
            <i class='bx bx-plus'></i> Registrar institución
        </button>
    }
    else
    {
        <a asp-action="Registrar" class="btn btn-success">
           Registrar institución
        </a>
    }
</div>


@model InstitucionCliente

@{
    ViewData["Title"] = "Edicion de  Institucion";
}

<a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-light">Volver a Detalle</a>

<h2>Editar Institucion</h2>
<div>
    <div>
        <form asp-action="Editar" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <partial name="_Formulario" model="Model"/>

            <button type="submit" class="btn btn-outline-success">Guardar Caambios</button>
            <a asp-action="Detalle" class="btn btn-outline-danger">Cancelar</a>
        </form>
    </div>
</div>

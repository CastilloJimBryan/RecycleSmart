@model InstitucionCliente

@{
    ViewData["Title"] = "Edicion de  Institucion";
    var tipos = ViewBag.Tipos as string[] ?? Array.Empty<string>(); 
}

@if(!ViewData.ModelState.IsValid)
{
    <div class="btn btn-danger" asp-validation-summary="ModelOnly"></div>
}

<div class="mb-4">
<a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-theme-success">
    <i class="bx bx-arrow-back"></i>
    Volver al Detalle</a>
</div>
<h2>Editar Institucion</h2>
<div class="card shadow-lg">
    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input name="nombre" value="@Model.Nombre" class="form-control" maxlength="100" required  autocomplete="off"/>
            </div>
            <div class="mb-3">
                <label class="form-label">CUIT</label>
                <input name="cuit" value="@Model.Cuit" class="form-control" required maxlength="13" autocomplete="off" />
            </div>
            <div class="mb-3">
                <label class="form-label">Direccion</label>
                <input name="direccion" class="form-control" value="@Model.Direccion" maxlength="100"  required autocomplete="off" />
            </div>
            <div class="mb-3">
                <label class="form-label">Tipo</label>
                <select name="tipo" class="form-select">
                    <option value=""> Seleccione un Tipo</option>
                    @foreach (var item in tipos)
                    {
                        <option value="@item" selected="@(item == Model.Tipo)">@item</option>
                    }
                </select>
            </div>
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-outline-success">Guardar Cambios</button>
                <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-danger">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@using RecycleSmartBLL
@model Lote

@{
    ViewData["Title"] = Model.Codigo;

    var deposito = ViewBag.Depositos as List<(DateTime fecha, string usuario, decimal volumen)> ?? new();
    var verificacion = ViewBag.Verificacion as (bool integro, string mensaje)?;
    var plazos = LoteBL.PlazoActual(Model);

    var pasos = new[]
    {
        (Tipo:TipoEstado.TipoHito.Generacion,Titulo:"Generacion" , Corto:"Generación"),
        (Tipo:TipoEstado.TipoHito.SolicitudRecoleccion,Titulo:"Solicitud de Recoleccion", Corto:"Solicitud"),
        (Tipo:TipoEstado.TipoHito.Recoleccion,Titulo:"Recoleccion", Corto:"Recolección"),
        (Tipo:TipoEstado.TipoHito.Tratamiento,Titulo:"Tratamiento", Corto:"Tratamiento"),
        (Tipo:TipoEstado.TipoHito.DisposicionFinal,Titulo:"Disposicion Final", Corto:"Disposición"),

    };

    int actual = Array.FindIndex(pasos, p => !Model.Hitos.Any(h => h.TipoHito == p.Tipo));

}

<partial name="_Mensajes"/>

<div>
    <a asp-action="Index" class ="btn btn-theme-success btn-sm mb-2">Volver</a>
</div>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h2 class="fs-4 mb-0"><code class="fs-4">@Model.Codigo</code></h2>
    <span class="badge text-bg-warning">@Model.EstadoLote</span>
    @if (Model.Conforme != null)
    {
        <span>@(Model.Conforme==true?"Conforme":"No Conforme")</span>
    }
</div>
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h6 class="text-uppercase text-muted small fw-semibold">Datos del lote</h6>
                <dl class="row small mb-0">
                    <dt class="col-5">Contenedor</dt>
                    <dd class="col-7">@Model.ContenedorNombre</dd>
                    <dt class="col-5">Institución</dt>
                    <dd class="col-7">@Model.InstitucionNombre</dd>
                    <dt class="col-5">Tipo de residuo</dt>
                    <dd class="col-7">@Model.TipoResiduo</dd>
                    <dt class="col-5">Volumen</dt>
                    <dd class="col-7">@Model.VolumenTotal.ToString("0.0") L en @Model.CantidadDepositada depósito(s)</dd>
                    <dt class="col-5">Generado</dt>
                    <dd class="col-7">@Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h6 class="text-uppercase text-muted small fw-semibold">Plazos (Ley 24.051)</h6>
                <dl class="row small">
                    <dt class="col-6">Recolección (5 días)</dt>
                    <dd class="col-6">hasta @Model.FechaLimiteRecoleccion.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-6">Tratamiento (72 h)</dt>
                    <dd class="col-6">@(Model.FechaLimiteTratamiento?.ToString("dd/MM HH:mm") is string ft ? $"hasta {ft}" : "desde la recolección")</dd>
                </dl>
                @if (plazos.Limite != null)
                {
                    string color = plazos.Vencido ? "bg-danger" : plazos.Porcentaje >= 80 ? "bg-warning" : "bg-success";
                    <div class="small mb-1">@plazos.Etapa: @plazos.Porcentaje % del plazo consumido</div>
                    <div class="progress" style="height:8px"><div class="progress-bar @color" style="@($"width:{plazos.Porcentaje}%")"></div></div>
                }
            </div>
        </div>
    </div>
</div>
@if(Model.EstadoLote==TipoEstado.EstadoLote.EnCurso && User.TieneRol(Roles.Gestion))
{
    <div class="card shadow-sm mb-3 border-success">
        <div class="card-body">
            <h6 class="text-uppercase text-muted small fw-semibold">Siguiente Paso : Solicitar Recolección</h6>
            <p class="text-muted small">Pedir que se retire el lote. El Plazo de Recoleccion vence el @Model.FechaLimiteRecoleccion.ToString("dd/MM HH:mm")</p>
            <form asp-action="SolicitarRecoleccion" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                <input type="hidden" name="id" value="@Model.Id" />
                <h6 class="text-muted">Observaciones</h6>
                <input type="text" name="observacion" maxlength="100" class="form-control" style="max-width:420px" placeholder="ejemplo, retirar antes del mediodia"/> 
                <button type="submit" class="btn btn-success">Solicitar Recoleccion</button>
            </form>
        </div>
    </div>
}
@* ---------- Línea de tiempo de los hitos ---------- *@
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h6 class="text-uppercase text-muted small fw-semibold mb-3">Ciclo de vida</h6>

        <div class="ciclo">
            @for (int i = 0; i < pasos.Length; i++)
            {
                var paso = pasos[i];
                var h = Model.Hitos.FirstOrDefault(x => x.TipoHito == paso.Tipo);
                string clase = h != null ? "hecho" : i == actual ? "actual" : "pendiente";
                <div class="ciclo-paso @clase">
                    <div class="ciclo-circulo" title="@paso.Titulo">@(h != null ? "✓" : "")@paso.Corto</div>
                    <div>
                        @if (h == null)
                        {
                            <div class="small text-muted">@(i == actual ? "Siguiente paso" : "")</div>
                        }
                        else
                        {
                            <div class="small">@h.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                            @if (!string.IsNullOrEmpty(h.UsuarioNombre))
                            {
                                <div class="small text-muted">@h.UsuarioNombre</div>
                            }
                            @if (h.DentroDelPlazo == true)
                            {
                                <span class="badge bg-success">En plazo</span>
                            }
                            @if (h.DentroDelPlazo == false)
                            {
                                <span class="badge bg-danger">Fuera de plazo</span>
                            }
                            @if (!string.IsNullOrEmpty(h.NumeroDocumento))
                            {
                                <div class="small text-muted">Doc. @h.NumeroDocumento</div>
                            }
                            @if (!string.IsNullOrEmpty(h.Observaciones))
                            {
                                <div class="small text-muted">@h.Observaciones</div>
                            }
                            <div class="small text-muted" title="@h.Observaciones">
                                <code title="@h.Hash">#@h.Hash[..8]…</code>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ---------- Integridad ---------- *@
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h6 class="text-uppercase text-muted small fw-semibold mb-1">Integridad del registro</h6>
                <div class="small text-muted">Cada hito está firmado y encadenado con el anterior. Cualquier cambio en la base se detecta.</div>
            </div>
            <a asp-action="Detalle" asp-route-id="@Model.Id" asp-route-verificar="true" class="btn btn-outline-dark">Verificar integridad</a>
        </div>
        @if (verificacion != null)
        {
            <div class="alert @(verificacion.Value.integro ? "alert-success" : "alert-danger") mt-3 mb-0">
                @(verificacion.Value.integro ? "✅" : "❌") @verificacion.Value.mensaje
            </div>
        }
    </div>
</div>

@* ---------- Depósitos ---------- *@
<div class="card shadow-sm">
    <div class="card-body">
        <h6 class="text-uppercase text-muted small fw-semibold">Depósitos del lote</h6>
        <table class="table table-sm mb-0">
            <thead><tr><th>Fecha</th><th>Usuario</th><th class="text-end">Volumen</th></tr></thead>
            <tbody>
                @foreach (var d in deposito)
                {
                    <tr><td>@d.fecha.ToString("dd/MM HH:mm")</td><td>@d.usuario</td><td class="text-end">@d.volumen.ToString("0.0") L</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@using System.Globalization
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    string posicion(DateTime f) => (f.TimeOfDay.TotalMinutes / 1440 * 100).ToString("0.##", CultureInfo.InvariantCulture);

    string textopropio(string t) => t switch
    {
        "Critico" => "Critico",
        "Advertencia" => "Advertencia",
        "SinConexion" => "Sin Conexion",
        _ => "Resuelta"
    };

    var p = Model.usoPlan;
    bool puedeGestionar = User.TieneRol(Roles.Operacion);
    bool VerAcceso = User.TieneRol(Roles.Control);
    int maxInstituciones = 3;
    var hoy = DateTime.Now.ToString("dddd d 'de' MMMM ", new CultureInfo("es-AR"));
    hoy = char.ToUpper(hoy[0]) + hoy.Substring(1);

    string Duracion(TimeSpan d) => d.TotalMinutes < 60 ? $"{(int)d.TotalMinutes} min"
    : d.TotalHours < 24 ? $"{(int)d.TotalHours} h{d.Minutes} min"
    : $"{(int)d.TotalDays}  d {d.Hours} h";

    string uso(int usados, int maximo) => maximo == 0 ? $"{usados} (Ilimitado)" : $"{usados}/{maximo}";
    int porcion (int usa, int maxi) => maxi == 0 ? 0 : Math.Min(100, usa * 100 / maxi);

    //orden primero las criticas

    var grupos = Model.Cola.GroupBy(a => new { a.InstitucionId, a.InstitucionNombre }).OrderByDescending(
    g => g.Any(a => a.TipoSeveridad == TipoEstado.Severidad.Critico)).ThenByDescending(g => g.Count()).ToList();

    int sinPendiente = Model.InstitucionClientes.Count(i => !Model.Cola.Any(a => a.InstitucionId == i.Id));
}

<div id="dashboard" data-institucion="@Model.InstitucionId" data-abiertas="@Model.AlertasAbiertaXEmpresa">
    <span class="text-capitalize text-muted">@hoy</span>
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h2 class="mb-0">Dashboard</h2>
            <div class="d-flex flex-wrap align-items-center gap-3 small text-muted mt-1">
                <span class="d-flex align-items-center gap-1">
                    <span class="progress" style="width:60px;height:6px">
                        <span class="progress-bar bg-success" style="@($"width:{porcion(p.Instituciones, p.MaxInstituciones)}%")"></span>
                    </span>
                    @uso(p.Instituciones,p.MaxInstituciones) Instituciones
                </span>
                <span class="d-flex align-items-center gap-1">
                    <span class="progress" style="width:60px;height:6px">
                        <span class="progress-bar bg-success" style="@($"width:{porcion(p.Contenedores, p.MaxContenedores)}%")"></span>
                    </span>
                    @uso(p.Contenedores,p.MaxContenedores) Contenedores
                </span>
            </div>
        </div>
        <form asp-action="Index" method="get">
            <label class="form-label small text-muted mb-1" for="institucionId">Institucion</label>
            <select class="form-select" id="institucionId" name="institucionId" onchange="this.form.submit()">
                <option value="0">Todas Las Instituciones (@Model.InstitucionClientes.Count) </option>
                @foreach (var item in Model.InstitucionClientes)
                    {
                        <option value="@item.Id" selected="@(item.Id==Model.InstitucionId)">@item.Nombre</option>
                    }
            </select>
        </form>
    </div>
    <div class="row row-cols-2 row-cols-lg-5 g-3 mb-4">
        <div class="col">
            <div class="card h-100 shadow-sm " style="border-top:4px solid var(--bs-danger)">
                <div class="card-body text-center">
                    <div class="fs-2 fw-semibold" id="kpi-criticos">@Model.ResumenDashboard.ContenedorCriticos</div>
                    <div class="text-muted small">Contenedores Criticos</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm" style="border-top:4px solid var(--bs-warning)">
                <div class="card-body text-center">
                    <div class="fs-2 fw-semibold" id="kpi-alertas">@Model.ResumenDashboard.AlertasAbiertas</div>
                    <div class="text-muted small">Alertas Abiertas</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm" style="border-top:4px solid var(--bs-secondary)">
                <div class="card-body text-center">
                    <div class="fs-2 fw-semibold" id="kpi-offline">@Model.ResumenDashboard.SensoresOffline</div>
                    <div class="text-muted small">Sensores Sin Conexion</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm" style="border-top:4px solid var(--bs-success)">
                <div class="card-body text-center">
                    <div class="fs-2 fw-semibold" id="kpi-acceso">@Model.ResumenDashboard.AccesosHoy</div>
                    <div class="text-muted small">Accesos Hoy  -  
                    <span id="kpi-denegado"> @Model.ResumenDashboard.AccesosDenegadosHoy </span> Denegados </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm" style="border-top:4px solid var(--bs-black)">
                <div class="card-body text-center">
                    <div class="fs-2 fw-semibold" id="kpi-litros">@Model.ResumenDashboard.LitrosHoy.ToString("0.#") L</div>
                    <div class="text-muted small">Depositado Hoy</div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class=" card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <h5 class="text-uppercase text-muted small fw-semibold mb-0">Necesitan Atencion</h5>
                        @if(Model.Cola.Count>0)
                        {
                            <span class="text-muted small">@Model.Cola.Count Pendientes</span>
                        }
                    </div>
                    @if(Model.Cola.Count==0)
                    {
                        <div class="text-success fw-semibold text-center py-3">Todo en Orden</div>
                    }
                    @foreach (var item in grupos)
                    {
                        if(Model.InstitucionId==0)
                        {
                            <div class="d-flex justify-content-between border-bottom pb-1 mb-2 mt-3">
                                <strong>@item.Key.InstitucionNombre</strong>
                                <span class="text-muted small">@item.Count() Pendientes</span>
                            </div>
                        }
                        foreach (var items in item.Take(maxInstituciones))
                        {
                            bool critico = items.TipoSeveridad == TipoEstado.Severidad.Critico;
                            <div class="d-flex flex-wrap align-items-center gap-2 border rounded p-2 mb-2" style="border-left: 5px solid @(critico?"var(--bs-danger)":"var(--bs-warning)")!important">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">
                                        @items.ContenedorNombre
                                        <span class="badge @(critico?"bg-danger":"bg-warning text-dark")">@items.TipoAlerta - @items.TipoSeveridad</span>
                                    </div>
                                    <div class="text-muted small">
                                        @items.Mensaje - Abierta Hace @Duracion(items.Duracion)
                                        @if (items.EstadoAlerta == TipoEstado.EstadoAlerta.EnGestion)
                                        {
                                            <text> En Gestion por @items.UsuarioGestionNombre</text>
                                        }
                                    </div>
                                </div>
                                <div class=" d-flex gap-1">
                                    @if(items.TipoAlerta==TipoEstado.TipoAlerta.Nivel && Model.LotesAbiertos.TryGetValue(items.ContenedorId,out var lote))
                                    {
                                        if(lote.Estado==TipoEstado.EstadoLote.EnCurso && User.TieneRol(Roles.Gestion))
                                        {
                                           <form asp-controller="Trazabilidad" asp-action="SolicitarRecoleccion" method="post" class="d-inline" onsubmit="this.querySelector('button').disabled=true;">
                                                <input type="hidden" name="id" value="@lote.LoteId" />
                                                <input type="hidden" name="observaciones" value="Solicitada desde el Dashboard por alerta de nivel"/>
                                                <button type="submit" class="btn btn-outline-primary btn-sm">Solicitar Recoleccion</button>
                                           </form>
                                        }
                                        else if(lote.Estado==TipoEstado.EstadoLote.RecoleccionSolicitada)
                                        {
                                            <a asp-controller="Trazabilidad" asp-action="Detalle" asp-route-id="@lote.LoteId" class="btn btn-outline-dark btn-sm">Recoleccion Solicitada</a>
                                        }
                                    }
                                    @if(puedeGestionar&&items.EstadoAlerta==TipoEstado.EstadoAlerta.Activa)
                                    {
                                        <form asp-controller="Alertas" asp-action="Tomar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@items.Id"/>
                                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                            <button type="submit" class="btn btn-sm btn-theme-success">Tomar</button>
                                        </form>
                                    }
                                    @if(puedeGestionar)
                                    {
                                        <a asp-controller="Alertas" asp-action="Resolver" asp-route-id="@items.Id" class="btn btn-outline-success btn-sm">Resolver</a>
                                    }
                                    @if(items.TipoAlerta==TipoEstado.TipoAlerta.AccesoNoAutorizado && VerAcceso)
                                    {
                                
                                        <a asp-controller="Acceso" asp-action="Index" asp-route-institucionid="@items.InstitucionId" class="btn btn-outline-secondary btn-sm">Ver Accesos</a>
                                    }
                                    else if(items.TipoAlerta!=TipoEstado.TipoAlerta.AccesoNoAutorizado)
                                    {   
                                        <a asp-controller="Contenedor" asp-action="Index" asp-route-institucionid="@items.InstitucionId" class="btn btn-outline-dark btn-sm">Ver Contenedores</a>
                                    }
                                </div>
                            </div>
                        }
                        if(item.Count()>maxInstituciones)
                        {
                            <a asp-controller="Alertas" asp-action="Index" class="small">Ver @item.Count() Alertas</a>
                        }
                    }
                    @if(Model.InstitucionId==0&&Model.Cola.Count>0 && sinPendiente>0)
                    {
                        <div class="alert alert-success py-2 mt-3 mb-0">@sinPendiente Instituciones Sin Pendientes</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm ">
                <div class="card-body">
                    <h5 class="text-uppercase text-muted small fw-semibold">Litros Depositados Por Hora</h5>
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="fs-4 fw-semibold " id="litros-total"></span>
                        <span class="small" id="litros-comparacion"></span>
                    </div>
                    <div style="height:200px">
                        <canvas id="grafico-litros" data-hoy="@Json.Serialize(Model.LitrosHora.Hoy)" data-ayer="@Json.Serialize(Model.LitrosHora.Ayer)"></canvas>
                    </div>
                    <div class="d-flex justify-content-between small text-muted border-top pt-2 mt-2">
                        <span id="litros-pico"></span>
                        @if(User.TieneRol(Roles.Control))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Acceso" asp-action="Index" asp-route-intitucionid="@Model.InstitucionId">Ver Log de Accesos</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <h5 class="text-uppercase text-muted small fw-semibold mb-0">Linea de Tiempo Hoy</h5>
                </div>
                <div class="linea-tiempo">
                    <div class="lt-eje"></div>
                    <div class="lt-pasado" style="width:@(posicion(DateTime.Now))%"></div>
                    @foreach (var item in Model.Linea)
                    {
                        <button type="button" class="lt-punto lt-@item.Tipo" style="@($"left:{posicion(@item.Fecha)}%")"
                         title="@item.Fecha.ToString("HH:mm") - @textopropio(item.Tipo)"
                        data-texto="@item.Fecha.ToString("HH:mm") - @textopropio(item.Tipo) - @item.Contenedor - @item.Mensaje"></button>
                    }
                    <div class="lt-ahora" style="left:@(posicion(DateTime.Now))%">
                        <span>@DateTime.Now.ToString("HH:mm")</span>
                    </div>
                    <div class="lt-horas">
                        <span>00</span>
                        <span>04</span>
                        <span>08</span>
                        <span>12</span>
                        <span>16</span>
                        <span>20</span>
                        <span>24</span>
                    </div>
                </div>
                <div class="small mt-2" id="lt-detalle">
                    @(Model.Linea.Count==0?"Sin Eventos Hoy.":"")
                </div>
                <div class="d-flex flex-wrap gap-3 small text-muted mt-2">
                    <span><span class="badge rounded-pill bg-danger">&nbsp;</span> Critica</span>
                    <span><span class="badge rounded-pill bg-warning">&nbsp;</span> Advertencia</span>
                    <span><span class="badge rounded-pill bg-secondary">&nbsp;</span> Sin Conexion</span>
                    <span><span class="badge rounded-pill bg-success">&nbsp;</span> Resuelta</span>
                    
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const tablero = document.getElementById("dashboard");
        const institucionId = Number(tablero.dataset.institucion);
        const abiertasAlCargar = Number(tablero.dataset.abiertas);

        // Pide los números al servidor y actualiza las tarjetas (sin recargar la página)
        async function actualizarResumen() {
            const resp = await fetch(`/Dashboard/Resumen?institucionId=${institucionId}`);
            if (!resp.ok) return;
            const r = await resp.json();
            document.getElementById("kpi-criticos").textContent = r.contenedoresCriticos;
            document.getElementById("kpi-alertas").textContent = r.alertasAbiertas;
            document.getElementById("kpi-offline").textContent = r.sensoresOffline;
            document.getElementById("kpi-acceso").textContent = r.accesosHoy;
            document.getElementById("kpi-denegado").textContent = r.accesosDenegadosHoy;
            document.getElementById("kpi-litros").textContent = r.litrosHoy.toLocaleString("es-AR", { maximumFractionDigits: 1 }) + " L";
            
            actualizarLitros();
        }

        // Si llegan varios mensajes seguidos, se actualiza una sola vez
        let espera = null;
        function programarActualizacion() {
            clearTimeout(espera);
            espera = setTimeout(actualizarResumen, 1500);
        }

        conexionMonitoreo.on("NuevoAcceso", programarActualizacion);
        conexionMonitoreo.on("DispositivoOffline", programarActualizacion);
        conexionMonitoreo.on("NuevaLectura", programarActualizacion);

        // Cambió la cola de alertas → recargar la página (es lo que más importa ver)
        conexionMonitoreo.on("AlertasAbiertas", total => {
            if (total !== abiertasAlCargar) location.reload();
        });
        conexionMonitoreo.on("NuevaAlerta", () => location.reload());

        //Grafico litros

        const canvas = document.getElementById("grafico-litros");
        const horas = Array.from({ length: 24 }, (_, h) => String(h).padStart(2, "0"));
        const horaActual = new Date().getHours();

        // Hoy: las horas que todavía no llegaron van en null (no se dibujan)
        const soloHastaAhora = datos => datos.map((v, h) => h > horaActual ? null : v);

        const grafico = new Chart(canvas, {
            data: {
                labels: horas,
                datasets: [
                    {
                        type: "bar", label: "Hoy",
                        data: soloHastaAhora(JSON.parse(canvas.dataset.hoy)),
                        backgroundColor: horas.map((_, h) => h === horaActual ? "rgba(25,135,84,.5)" : "rgb(25,135,84)"),
                        borderRadius: 2
                    },
                    {
                        type: "line", label: "Ayer",
                        data: JSON.parse(canvas.dataset.ayer),
                        borderColor: "#6c757d", borderDash: [4, 3], borderWidth: 1.5,
                        pointRadius: 0, tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: "bottom", labels: { boxWidth: 12 } } },
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => v + " L" } },
                    x: { ticks: { maxTicksLimit: 8 } }
                }
            }
        });

        function resumirLitros() {
            const hoy = grafico.data.datasets[0].data.map(v => v ?? 0);
            const ayer = grafico.data.datasets[1].data;
            const total = hoy.reduce((a, b) => a + b, 0);
            const ayerHastaAhora = ayer.slice(0, horaActual + 1).reduce((a, b) => a + b, 0);
            const pico = hoy.indexOf(Math.max(...hoy));

            document.getElementById("litros-total").textContent =
                total.toLocaleString("es-AR", { maximumFractionDigits: 1 }) + " L";

            const comp = document.getElementById("litros-comparacion");
            if (ayerHastaAhora > 0) {
                const dif = Math.round((total / ayerHastaAhora - 1) * 100);
                comp.innerHTML = `<span class="${dif >= 0 ? "text-success" : "text-warning"}">${dif >= 0 ? "▲" : "▼"} ${Math.abs(dif)} %</span> vs. ayer a esta hora`;
            } else {
                comp.textContent = "";
            }

            document.getElementById("litros-pico").textContent =
                total > 0 ? `Pico: ${horas[pico]} h · ${hoy[pico].toLocaleString("es-AR")} L` : "Sin depósitos hoy";
        }
        resumirLitros();

        async function actualizarLitros() {
            const resp = await fetch(`/Dashboard/Litros?institucionId=${institucionId}`);
            if (!resp.ok) return;
            const l = await resp.json();
            grafico.data.datasets[0].data = soloHastaAhora(l.hoy);
            grafico.data.datasets[1].data = l.ayer;
            grafico.update();
            resumirLitros();
        }
        // ---------- Línea de tiempo ----------
        const detalle = document.getElementById("lt-detalle");
        const puntos = document.querySelectorAll(".lt-punto");
        puntos.forEach(p => {
            const mostrar = () => detalle.textContent = p.dataset.texto;
            p.addEventListener("mouseenter", mostrar);
            p.addEventListener("focus", mostrar);
            p.addEventListener("click", mostrar);
        });
        // Al cargar, se muestra el último evento del día
        if (puntos.length > 0) detalle.textContent = puntos[puntos.length - 1].dataset.texto;
    </script>
}
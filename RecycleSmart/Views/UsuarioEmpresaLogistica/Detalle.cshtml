@model UsuarioEmpresaLogistica

@{
    ViewData["Title"] = "Detalle Usuario Empresa";
    var estado=Model.Estados.ToString();

    bool esUsuarioActual = ViewBag.EsUsuarioActual ?? false;
    bool esBaja = estado == "Baja";

}

<div>
    <a asp-action="Index" class="btn btn-theme-success mb-3">
        <i class="bx bx-arrow-back "></i>
        Volver al Listado
    </a>
</div>

<partial name="_Mensajes"/>

<div class="card shadow-sm"  style="max-width:700px">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4>
            @Model.Nombre, @Model.Apellido
            @if (esUsuarioActual)
            {
                <small class="text-muted">(Usted)</small>
            } 
        </h4>
        <span class="badge @EstadosColor.EstadoBadge(estado)">@estado</span>
    </div>
    <div class="card-body">
            <dl class="row">
            <div class="col-sm-4">
                <dt>Correo</dt>
                <dd>@Model.Correo</dd> 
            </div>
            <div class="col-sm-4">
                <dt>Rol</dt>
                <dd>@Model.Rol</dd>
            </div>
            </dl>
    </div>
    <div class="card-footer">
        @if(esBaja)
        {
            <span class="text-muted">Usuario de baja no se puede Editar</span>
        }
        else
        {
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-dark">
                <i class="bx bx-edit"></i>  
                Editar
            </a>
            @if(!esUsuarioActual)
            {
                <form asp-action="CambiarEstado" method="post">
                    <input  type="hidden" name="id" value="@Model.Id"/>
                        @if (estado == "Activo")
                        {
                            <button name="estado" value="Suspendido" class="btn btn-outline-warning">Suspender</button>
                        }
                        else
                        {
                            <button name="estado" value="Activo" class="btn btn-outline-success">ReActivar</button>
                        }
                </form>
                    <button name="estado" value="Baja" class="btn btn-outline-danger">
                        <i></i> Dar de Baja
                    </button>
            }
        }
    </div>
</div>
@if (!esBaja)
{
    <div class="card shadow-sm" style="max-width: 700px;">
        <div class="card-header"><strong>Restablecer clave</strong></div>
        <div class="card-body">
            <form asp-action="RestablecerClave" method="post" autocomplete="off" class="row g-2 align-items-end">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-sm-8">
                    <label class="form-label">Nueva clave</label>
                    <input type="password" name="claveNueva" class="form-control"
                           autocomplete="new-password" required />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-outline-dark w-100"
                            onclick="return confirm('¿Reemplazar la clave de este usuario?');">
                        <i class='bx bx-key'></i> Restablecer
                    </button>
                </div>
            </form>
        </div>
    </div>
}

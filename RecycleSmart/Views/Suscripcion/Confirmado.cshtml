@model RecycleSmartBE.Plan
@{
    ViewData["Title"] = "Plan actualizado";
    var ar = new System.Globalization.CultureInfo("es-AR");
    DateTime rige = ViewBag.RigeDesde;
}

<div class="card shadow-sm mx-auto text-center" style="max-width:620px">
    <div class="card-body py-5">
        <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width:64px;height:64px;background:#d1e7dd">
            <i class="bx bx-check text-success" style="font-size:40px"></i>
        </div>
        <h3 class="mb-2">Plan actualizado a @Model.Nombre</h3>
        <p class="text-muted mb-4">
           El nuevo precio se aplica en la proxima facturacion
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a asp-action="Index" class="btn btn-success btn-sm"> <i class="bx bx-show"></i> Ver mi suscripción</a>
            <a asp-action="Index" fragment="facturas" class="btn btn-outline-success btn-sm"> <i class="bx bx-history"></i> Ver historial de facturas</a>
        </div>
    </div>
</div>
@model RecycleSmart.Models.PlanesViewModel
@{
    ViewData["Title"] = "Cambiar plan";
    var ar = new System.Globalization.CultureInfo("es-AR");
    string Usd(decimal m) => "US$ " + m.ToString("N0", ar);
    string Inst(int n) => n == 0 ? "Instituciones ilimitadas" : $"Hasta {n} instituciones";
    string Cont(int n) => n == 0 ? "Contenedores ilimitados" : $"Hasta {n} contenedores";
}
<div class="mb-2">
<a asp-action="Index" class="btn btn-theme-success btn-sm"> <i class="bx bx-arrow-from-right"></i> Volver</a>
</div>
<div class="mb-3">
     <h2 class="mb-0">Elegí tu nuevo plan</h2>
</div>

<partial name="_Mensajes" />

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-3">
    @foreach (var op in Model.Planes)
    {
        var p = op.Plan;
        string borde = op.esActual ? "border-success border-3" : !op.Compatible ? "bg-light" : "";
        <div class="col">
            <div class="card h-100 shadow-sm @borde">
                <div class="card-body d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-4 fw-bold @(op.esActual ? "text-success" : !op.Compatible ? "text-muted" : "")">@p.Nombre</span>
                        @if (op.esActual)
                        {
                            <span class="badge text-bg-success bg-opacity-25 text-success-emphasis">Plan actual</span>
                        }
                    </div>
                    <div class="fs-4 fw-semibold @(!op.Compatible ? "text-muted" : "")">@Usd(p.PrecioMensual) <span class="fs-6 fw-normal text-muted">/ mes</span></div>
                    <div class="small @(!op.Compatible ? "text-muted" : "")">@Inst(p.MaxInstituciones)<br />@Cont(p.MaxContenedores)</div>

                    @if (op.Compatible)
                    {
                        <div class="small text-success"> <i class="bx bx-check"></i> Tu uso actual entra en este plan</div>
                    }
                    else
                    {
                        <div class="alert alert-danger small py-2 mb-0">
                            Tu uso supera este plan. Para elegirlo, dá de baja
                            @if (op.InstitucionesDeMas > 0)
                            {
                                <strong>@op.InstitucionesDeMas instituciones</strong>
                            }
                            @if (op.InstitucionesDeMas > 0 && op.ContenedoresDeMes > 0)
                            {
                                <text> y </text>
                            }
                            @if (op.ContenedoresDeMes > 0)
                            {
                                <strong>@op.ContenedoresDeMes contenedores</strong>
                            }
                            .
                        </div>
                    }

                    <div class="mt-auto pt-2">
                        @if (op.esActual)
                        {
                            <button type="button" class="btn btn-outline-success w-100 btn-sm" disabled><i class="bx bx-badge-check"></i> Activo</button>
                        }
                        else if (!op.Compatible)
                        {
                            <button type="button" class="btn btn-outline-secondary w-100 btn-sm" disabled>No disponible</button>
                        }
                        else
                        {
                            <a asp-action="Resumen" asp-route-planId="@p.Id" class="btn btn-success w-100 btn-sm"> <i class="bx bx-check"></i> Elegir este plan</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
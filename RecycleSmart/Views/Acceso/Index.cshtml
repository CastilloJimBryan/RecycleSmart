@using RecycleSmartBLL
@model List<EventoAcceso>
@{
    ViewData["Tile"] = "Log de Accesos";
    var instituciones = ViewBag.Instituciones as List<InstitucionCliente> ?? new();
    int instiId = ViewBag.InstitucionId ?? 0;
    bool denegado = ViewBag.Denegados ?? false;
}

<h2>Log de Accesos</h2>
<form method="get" class="row g-2 align-items-end mb-3" >
        <div class="col-md-5">
            <label class="form-label">Institucion</label>
            <select name="institucionid" class="form-select" onchange="this.form.submit()">
                <option value="0">Todas</option>
                @foreach (var item in instituciones)
                    {
                        <option value="@item.Id" selected="@(item.Id==instiId)">@item.Nombre</option>     
                    }
            </select>
        </div>
        <div class="col-md-4">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" value="true" name="denegados" id="checkDenegados" checked="@denegado" onchange="this.form.submit()" />
                <label class="form-check-label" for="checkDenegados">Solo Denegados</label>
            </div>
        </div>
</form>

@if(Model.Count==0)
{
    <div>No hay Registros con ese Filtro</div>
}
else
{
    <div class="card shadow">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-success">
                <tr>
                    <th>Usuario</th>
                    <th>Institucion</th>
                    <th>Contenedor</th>
                    <th>Fecha</th>
                    <th>Motivo</th>
                    <th>Nivel Pre-Deposito</th>
                    <th>Nivel Post-Deposito</th>
                    <th>Volumen</th>
                    <th>Estado de Acceso</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    bool permitido = item.EstadoAcceso == TipoEstado.EstadoAcceso.Permitido;
                    bool desconocida = item.Motivo == TipoEstado.MotivoAcceso.TarjetaDesconocida;
                    <tr class="@(desconocida ? "Table-Danger":"")">
                        <td>
                            @(item.UsuarioNombre??"Desconocido")
                            <div>
                                <small class="text-muted"><code>@item.UIDLeido</code></small>
                            </div>
                        </td>
                        <td>
                            @item.InstitucionNombre
                        </td>
                        <td>
                            @item.ContenedorNombre
                        </td>
                        <td>
                            @item.Fecha.ToString("dd/MM/yyyy HH:mm:ss")
                        </td>
                        <td>
                            @(permitido?"-": AlertaBL.MotivoText(item.Motivo))
                        </td>
                        <td style="min-width: 110px;">
                            @if (item.NivelPrevio.HasValue)
                            {
                                <div class="progress" style="height:16px;">
                                    <div class="progress-bar bg-secondary" style="width:@(item.NivelPrevio)% ">
                                        @item.NivelPrevio %
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span>-</span>
                            }

                        </td>
                        <td style="min-width:110px">
                            @if (item.NivelPosterior.HasValue)
                            {
                                <div class="progress" style="height:16px">
                                    <div class="progress-bar bg-primary" style="width:@(item.NivelPosterior)%">
                                        @item.NivelPosterior %
                                    </div>
                                </div>
                            }
                            else if(item.EstadoAcceso==TipoEstado.EstadoAcceso.Permitido && item.NivelPrevio.HasValue)
                            {
                                <small class="text-muted">....Esperando Lectura.</small>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if(item.VolumenDepositado.HasValue)
                            {
                                var volumen = item.VolumenDepositado.Value;
                                <span class="@(volumen>=0?"text-success":"text-danger")">
                                    @(volumen>=0?$"+{volumen:0.0}L": $"-{-volumen:0.0}L")
                                </span>
                                <div>
                                    <small class="text-muted">@(volumen>=0 ?"Depositado":"Retirados")</small>
                                </div>                        
                                
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(permitido?"bg-success":"bg-danger")">@item.EstadoAcceso</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
}

@section Scripts {
    <script>
        // Llegó un acceso nuevo (permitido o denegado) → recargar con los mismos filtros
        conexionMonitoreo.on("NuevoAcceso", () => location.reload());
    </script>
}
@{
    ViewData["Title"] = "Agregar DispositivoIoT";
    var contenedor = ViewBag.Contenedor as Contenedor;
}
@if(!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
}

<a asp-controller="Contenedor" asp-action="Index" asp-route-institucionId="@contenedor?.InstitucionId">
    Volver al Listado de Contenedores
</a>
<h2>Vincular Dispositivo</h2>
<p>@contenedor?.Nombre</p>
<div>
    <div class="card-body">
        <form asp-action="RegistrarDispositivo" method="post" autocomplete="off">
            <input type="hidden" name="contenedorid" value="@contenedor?.Id"/>
            <div>
                <label>Direccion MacAdrress</label>
                <input name="mac" value="@ViewBag.MAC" class="font-monospace" maxlength="17" />
            </div>
            <div>
                <label>Version de Firmware</label>
                <input name="firmware" value="@ViewBag.Firmware" maxlength="30" />
            </div>
            <div>
                <button type="submit">Vincular</button>
                <a asp-controller="Contenedor" asp-action="Index" asp-route-institucionId="@contenedor?.InstitucionId">Cancelar</a>
            </div>
        </form>
    </div>
</div>

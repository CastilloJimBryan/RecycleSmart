@using System.Globalization;
@model Umbral

@{
    ViewData["Title"] = "Configuracion de  Umbral";
    var contenedores = ViewBag.Contenedor as Contenedor;
    bool nuevo = Model.Id == 0;
    var estadosync = Model.EstadoSync.ToString();
}
@if(!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
}
<partial name="_Mensajes" />
<div class="mb-2">
    <a asp-controller="Contenedor" asp-action="Index" asp-route-institucionId="@contenedores?.InstitucionId" class="btn btn-theme-success">
        <i class="bx bx-arrow-back"></i> Volver a Contenedores
    </a>
</div>


<h2>Umbrales de Alerta - @contenedores?.Nombre</h2>
<p>
    @if(nuevo)
    {
        <span class="badge bg-dark text-white ms-2">Sin Configurar</span>
    }
    else
    {
       <span class="badge @EstadosColor.EstadoBadge(estadosync)">@estadosync</span>
        <small>Ultima Modificacion : @Model.UltimaActualizacion.ToString("dd/MM/yyyy HH:mm")</small>
    }
</p>
<div class=" card shadow " style="max-width:700px">
    <div class="card-body">
        <form asp-action="RegistrarUmbral" method="post">
            <input name="contenedorid" type="hidden" value="@Model.ContenedorId"/>
        
            <div class="mb-3">
                <label class="form-label">Nivel de Advertencia</label>
                <div class="input-group">
                <input name="niveladvertencia" type="number"  class="form-control" value="@Model.NivelAdvertencia" required  />
                <span class="input-group-text">%</span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Nivel Critico</label>
                <div class="input-group">
                <input name="nivelcritico" type="number" class="form-control" value="@Model.NivelCritico" required /> 
                <span class="input-group-text">%</span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Temperatura Maxima</label>
                <div class="input-group">
                <input name="tempmaxima" type="number" class="form-control" value="@Model.TemperaturaMaxima.ToString(CultureInfo.InvariantCulture)" />
                <span class="input-group-text">C°</span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Humedad Maxima</label>
                <div class="input-group">
                <input name="humedad" type="number" class="form-control" value="@Model.HumedadMaxima" required/>
                <span class="input-group-text">%</span>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Tiempo sin Conexion</label>
                <div class="input-group">
                    <input name="minutosinconexion" type="number" class="form-control" value="@Model.MinutosSinConexion" required min="1" max="1440" />
                    <span class="input-group-text">Min.</span>
                </div>
                <div class="text-muted">Tiempo maximo que puede estar sin conexion en minutos (maximo 24hs )</div>
            </div>
           
            <div class="mb-3 d-flex justify-content-between">
            <button type="submit" class="btn btn-outline-success">@(nuevo?"Guardar Configuracion":"Guardar")</button>
            <a asp-controller="Contenedor" asp-action="Index" asp-route-institucionId="@contenedores?.InstitucionId" class="btn btn-outline-danger">Cancelar</a>
            </div>
        </form>
    </div>
</div>
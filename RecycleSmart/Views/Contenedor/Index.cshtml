@using RecycleSmartBLL
@model List<RecycleSmartBE.Contenedor>

@{
    ViewData["Title"] = "Listado de Contenedores";
    var insti = ViewBag.Instituciones as List<InstitucionCliente> ?? new();
    int instiId = ViewBag.InstitucionId ?? 0;
    int usada = ViewBag.Usado ?? 0;
    int maximo = ViewBag.Maximo ?? 0;
    var dispositivo = ViewBag.Dispositivos as Dictionary<int, DispositivoIoT> ?? new();
    bool limiteAlcanzado = maximo != 0 && usada >= maximo;
    bool PuedeGestionaar = User.IsInRole(Roles.Administrador);
    var umbral = ViewBag.Umbrales as Dictionary<int, Umbral> ?? new();
    var lecturas = ViewBag.Lecturas as Dictionary<int, Telemetria> ?? new();
    bool bajas = ViewBag.Bajas ?? false;

    string textmotivo(TipoEstado.MotivoBaja? m) => m switch
    {
        TipoEstado.MotivoBaja.FallaEquipo => "Falla Equipo",
        TipoEstado.MotivoBaja.Reemplazo => "Reemplazo",
        TipoEstado.MotivoBaja.CierreArea => "Cierre Area",
        TipoEstado.MotivoBaja.Otro => "Otro",
        _ => ""
    };

}


<partial name="_Mensajes" /> 
<div>
    <h2>Contenedores</h2>
</div>
<p class="text-muted">
    @(maximo == 0 ? $"{usada} contenedores · plan ilimitado" : $"{usada} de {maximo} contenedores de su plan")
    @if (limiteAlcanzado)
    {
        <span class="text-danger fw-semibold"> · Límite alcanzado</span>
    }
</p>

<form method="get" asp-action="Index">
    <input type="hidden" name="bajas" value="@(bajas ? "true" : "false")" />
    <label class="form-label">Instituciones</label>
    <select name="institucionId" class="form-select mb-3" onchange="this.form.submit() ">
        <option value="0">Seleccione una Institucion</option>
        @foreach (var item in insti)
            {
                <option value="@item.Id" selected="@(item.Id==instiId)">@item.Nombre</option>
            }
        </select>

</form> 


@if(insti.Count==0)
{
    <p class="text-muted">Todavia no hay instituciones registradas</p>
}
else
{
    
    if (instiId == 0)
    {
        <div class="alert alert-info">Seleccione una Institucion Para ver los contenedores</div>
    }

    else
    {
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a asp-action="Index" asp-route-institucionId="@instiId"
                   class="nav-link @(!bajas ? "active" : "")">Activos</a>
            </li>
            <li class="nav-item">
                <a asp-action="Index" asp-route-institucionId="@instiId" asp-route-bajas="true"
                   class="nav-link @(bajas ? "active" : "")">Dados de baja</a>
            </li>
        </ul>

        <div class="mb-2">

            @if (PuedeGestionaar && !bajas)
            {
                if (limiteAlcanzado)
                {
                    <button class="btn btn-success" disabled title="Alcanzo el Limite del Plan">Registrar Contenedor</button>
                }
                else
                {
                    <a asp-controller="Contenedor" asp-action="Registrar" asp-route-institucionId="@instiId" class="btn btn-success">Registrar Contenedor</a>
                }
            }
        </div>
        @if (Model.Count == 0)
        {
            <div class="alert alert-info">@(bajas ? "No hay contenedores dados de baja en esta institución." : "Todavía no tiene contenedores.")</div>
        }
        else
        {     
        <div class="card shadow">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table table-success ">
                        <tr>
                            <th>Nombre</th>
                            <th class="text-nowrap">Tipo Residuo</th>
                            <th>Capacidad</th>
                            <th>Piso</th>
                            <th>Sector</th>
                            <th>DispositivoIoT</th>
                            <th>Estado</th>
                            <th>@(bajas?"Fecha":"Nivel")</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var estado = item.Estado.ToString();
                            var piso = item.Piso switch { null => "", 0 => "PB", < 0 => $"Subsuelo {-item.Piso}", _ => $"Piso {item.Piso}" };
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.TipoResiduo</td>
                                <td class="text-nowrap">@item.CapacidadLitros L</td>
                                <td class="text-nowrap">@piso</td>
                                <td>@item.Sector</td>
                                <td class="text-nowrap">
                                    @if(dispositivo.TryGetValue(item.Id,out var dispositivos))
                                    {
                                        var estadoDispositivo = dispositivos.EstadoDispositivo.ToString();
                                            <code><small>@dispositivos.MacAdress</small></code>
                                        <span class="badge @EstadosColor.EstadoBadge(estadoDispositivo)" data-dispositivo-contenedor="@item.Id" >@estadoDispositivo</span>
                                    }
                                    else if(PuedeGestionaar&&estado!="Baja")
                                    {
                                        <a class="btn btn-outline-dark btn-sm" asp-controller="DispositivoIoT" asp-action="RegistrarDispositivo" asp-route-contenedorId="@item.Id">
                                            Vincular
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin DispositivoIoT</span>
                                    }
                                </td>     
                                <td>
                                      <span class="badge @EstadosColor.EstadoBadge(estado)">@estado</span>
                                </td>
                                
                                @if(bajas)
                                {
                                    <td>
                                        @item.FechaBaja?.ToString("dd/MM/yyyy")
                                        <div class="small text-muted">@textmotivo(item.MotivoBaja)</div>
                                    </td>
                                }
                                else
                                {
                                     <td style="min-width: 180px;" data-nivel-contenedor="@item.Id">
                                        @if(lecturas.TryGetValue(item.Id,out var lectura))
                                        {
                                            umbral.TryGetValue(item.Id, out var umbralcont);
                                            var clase=UmbralBL.ClasificarLectura(lectura,umbralcont);
                                                bool viejo = UmbralBL.LecturaDesactualizada(lectura, umbralcont);
                                                var color = clase switch
                                                {
                                                    TipoEstado.ClasificacionLectura.Critico => "bg-danger",
                                                    TipoEstado.ClasificacionLectura.Advertencia => "bg-warning",
                                                    _=>"bg-success"
                                                };
                                                <div class="progress" style="height: 18px; @(viejo ? "opacity:0.5;":"")">
                                                    <div class ="progress-bar @color" style="width: @lectura.Nivel%" >@lectura.Nivel %</div>
                                                </div>
                                                    <small class="text-muted d-block">
                                                        @lectura.Temperatura.ToString("0.0") °C - @lectura.FechaHora.ToString("dd/MM/yyyy - HH:mm:ss")
                                                    </small>
                                                    <div class="d-flex flex-wrap gap-1 mt-1 small">
                                                        @if (clase != TipoEstado.ClasificacionLectura.Normal)
                                                        {
                                                            <span class="badge @color">@clase</span>
                                                        }
                                                        @if(viejo)
                                                        {
                                                            <span class="badge bg-secondary">Sin Datos Recientes</span>
                                                        }
                                                    </div>
                                        }
                                        else
                                        { 
                                            <span class="text-muted">Sin Lecturas</span>

                                        }
                                     </td>
                                }
                           
                                <td class="text-nowrap">
                                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-theme-success btn-sm">Ver</a>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>      
                
        }
    }
}

@section Scripts {
    <script>
        const colores = {
            "Critico": "bg-danger",
            "Advertencia": "bg-warning",
            "Normal": "bg-success"
        };

       

         conexionMonitoreo.on("NuevaLectura", l => {
            // ¿El contenedor está en esta pantalla? (puede ser de otra institución de la empresa)
            const celda = document.querySelector(`[data-nivel-contenedor="${l.contenedorId}"]`);
            if (!celda) return;

            const color = colores[l.clase] ?? "bg-success";
            const badge = l.clase !== "Normal" ? ` <span class="badge ${color}">${l.clase}</span>` : "";

            const badgeDisp = document.querySelector(`[data-dispositivo-contenedor="${l.contenedorId}"]`);
            if (badgeDisp) {
                badgeDisp.textContent = "Activo";
                badgeDisp.className = "badge bg-success";
            }

            celda.innerHTML =
                `<div class="progress" style="height: 18px;">
                             <div class="progress-bar ${color}" style="width: ${l.nivel}%">${l.nivel} %</div>
                         </div>
                         <small class="text-muted d-block">${l.temperatura} °C · ${l.fecha}</small>
                                 <div class="d-flex flex-wrap gap-1 mt-1">${badge}</div>`

            // Resaltar la celda un instante para que se note el cambio
            celda.classList.add("table-info");
            setTimeout(() => celda.classList.remove("table-info"), 1500);
        });

        conexionMonitoreo.on("DispositivoOffline", d => {
            const badgeDisp = document.querySelector(`[data-dispositivo-contenedor="${d.contenedorId}"]`);
            if (badgeDisp) {
                badgeDisp.textContent = "Offline";
                badgeDisp.className = "badge bg-secondary";
            }
        });

    </script>
}
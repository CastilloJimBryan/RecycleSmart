@using RecycleSmartBLL
@model List<RecycleSmartBE.Contenedor>

@{
    ViewData["Title"] = "Listado de Contenedores";
    var insti = ViewBag.Instituciones as List<InstitucionCliente> ?? new();
    int instiId = ViewBag.InstitucionId ?? 0;
    int usada = ViewBag.Usado ?? 0;
    int maximo = ViewBag.Maximo ?? 0;
    var dispositivo = ViewBag.Dispositivos as Dictionary<int, DispositivoIoT> ?? new();
    bool limiteAlcanzado = maximo != 0 && usada >= maximo;
    bool PuedeGestionaar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Responsable);
    var umbral = ViewBag.Umbrales as Dictionary<int, Umbral> ?? new();
    var lecturas = ViewBag.Lecturas as Dictionary<int, Telemetria> ?? new();
}
<partial name="_Mensajes" />
<div>
    <h2>Contenedores</h2>
</div>
<p class="text-muted">
    @(maximo == 0 ? $"{usada} contenedores · plan ilimitado" : $"{usada} de {maximo} contenedores de su plan")
    @if (limiteAlcanzado)
    {
        <span class="text-danger fw-semibold"> · Límite alcanzado</span>
    }
</p>

<form method="get" asp-action="Index">
    <label class="form-label">Instituciones</label>
    <select name="institucionId" class="form-select mb-3" onchange="this.form.submit() ">
        <option value="0">Seleccione una Institucion</option>
        @foreach (var item in insti)
            {
                <option value="@item.Id" selected="@(item.Id==instiId)">@item.Nombre</option>
            }
        </select>

    </form> 
@if (instiId == 0)
{
    <div class="alert alert-info">Seleccione una Institucion Para ver los contenedores</div>
}

else
{
    <div class="mb-2">

        @if (PuedeGestionaar)
        {
            @if (limiteAlcanzado)
            {
                <button class="btn btn-success" disabled title="Alcanzo el Limite del Plan">Registrar Contenedor</button>
            }
            else
            {
                <a asp-controller="Contenedor" asp-action="Registrar" asp-route-institucionId="@instiId" class="btn btn-success">Registrar Contenedor</a>
            }
        }
    </div>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Todavia no tiene contenedores</div>
    }
    else
    {     
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table table-success ">
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo Residuo</th>
                        <th>Capacidad</th>
                        <th>Piso</th>
                        <th>Sector</th>
                        <th>DispositivoIoT</th>
                        <th>Estado</th>
                        <th>Nivel</th>
                        <th>Umbrales</th>
                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var estado = item.Estado.ToString();
                        var piso = item.Piso switch { null => "", 0 => "PB", < 0 => $"Subsuelo {-item.Piso}", _ => $"Piso {item.Piso}" };
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.TipoResiduo</td>
                            <td>@item.CapacidadLitros L</td>
                            <td>@piso</td>
                            <td>@item.Sector</td>
                            <td>
                                @if(dispositivo.TryGetValue(item.Id,out var dispositivos))
                                {
                                    var estadoDispositivo = dispositivos.EstadoDispositivo.ToString();
                                    <span class="badge @EstadosColor.EstadoBadge(estadoDispositivo)">@estadoDispositivo</span>
                                    <small>@dispositivos.MacAdress</small>
                                }
                                else if(PuedeGestionaar&&estado!="Baja")
                                {
                                    <a asp-controller="DispositivoIoT" asp-action="RegistrarDispositivo" asp-route-contenedorId="@item.Id">
                                        Vincular
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Sin DispositivoIoT</span>
                                }
                            </td>
                            <td>
                                <span class="badge @EstadosColor.EstadoBadge(estado)">@estado</span>
                            </td>
                                <td style="min-width: 180px;" data-nivel-contenedor="@item.Id">
                                @if(lecturas.TryGetValue(item.Id,out var lectura))
                                {
                                    umbral.TryGetValue(item.Id, out var umbralcont);
                                    var clase=UmbralBL.ClasificarLectura(lectura,umbralcont);
                                        var color = clase switch
                                        {
                                            "Critico" => "bg-danger",
                                            "Advertencia" => "bg-warning",
                                            "Sin Datos" => "bg-secondary",
                                            _=>"bg-success"
                                        };
                                        <div class="progress" style="height: 18px;">
                                            <div class ="progress-bar @color" style="width: @lectura.Nivel%" >@lectura.Nivel %</div>
                                        </div>
                                            <small class="text-muted">
                                                @lectura.Temperatura °C - @lectura.FechaHora.ToString("dd/MM HH:mm")
                                                @if (clase != "Normal")
                                                {
                                                    <span class="badge @color">@clase</span>
                                                }
                                            </small>
                                }
                                else
                                {
                                    <span class="text-muted">Sin Lecturas</span>

                                }
                            </td>
                            <td>
                                @if(PuedeGestionaar && estado!="Baja")
                                {
                                    bool tiene = umbral.ContainsKey(item.Id);
                                    <a asp-controller="Umbral" asp-action="RegistrarUmbral" asp-route-contenedorId="@item.Id"
                                     class=" btn btn-sm btn-outline-dark">@(tiene ? "Editar":"Configurar")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">@(umbral.ContainsKey(item.Id) ? "Configurado" : "-")</span>
                                }
                            </td>

                        </tr>
                    }

                </tbody>
            </table>
               
                }
        </div>
    </div>      
    }
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const colores = {
            "Critico": "bg-danger",
            "Advertencia": "bg-warning",
            "Sin datos": "bg-secondary",
            "Normal": "bg-success"
        };

        const conexion = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/monitoreo")
            .withAutomaticReconnect()
            .build();

        conexion.on("NuevaLectura", l => {
            // ¿El contenedor está en esta pantalla? (puede ser de otra institución de la empresa)
            const celda = document.querySelector(`[data-nivel-contenedor="${l.contenedorId}"]`);
            if (!celda) return;

            const color = colores[l.clase] ?? "bg-success";
            const badge = l.clase !== "Normal" ? ` <span class="badge ${color}">${l.clase}</span>` : "";

            celda.innerHTML =
                `<div class="progress" style="height: 18px;">
                             <div class="progress-bar ${color}" style="width: ${l.nivel}%">${l.nivel} %</div>
                         </div>
                         <small class="text-muted">${l.temperatura} °C · ${l.fecha}${badge}</small>`;

            // Resaltar la celda un instante para que se note el cambio
            celda.classList.add("table-info");
            setTimeout(() => celda.classList.remove("table-info"), 1500);
        });

        conexion.start().catch(err => console.error("SignalR:", err));
    </script>
}
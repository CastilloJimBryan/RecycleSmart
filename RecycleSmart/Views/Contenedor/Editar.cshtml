@using System.Globalization
@model Contenedor

@{
    ViewData["Title"] = "Editar Contenedor";
    var tipos = ViewBag.Tipos as string[] ?? Array.Empty<string>();

}

<h2>Editar Contenedor - @Model.Nombre</h2>

<partial name="_Error"/>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="mb-2">
                <label class="form-label">Nombre</label>
                <input type="text" name="nombre" value="@Model.Nombre" class="form-control" maxlength="100" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Tipo Residuo</label>
                <select name="tiporesiduo" class="form-select">
                    <option value="">Seleccionar un Tipo</option>
                    @foreach (var item in tipos)
                    {
                        <option value="@item" selected="@(item == Model.TipoResiduo)">@item</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Capacidad</label>
                <div class="input-group">
                    <input name="CapacidadLitros" class="form-control" type="number" min="1" required value="@(Model.CapacidadLitros.ToString(CultureInfo.InvariantCulture))" />
                    <span class="input-group-text">Litros</span>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col">
                    <label class="form-label">Piso</label>
                    <input name="piso" type="number" value="@Model.Piso" min="-5" max="100" required  class="form-control" />
                </div>
                <div class="col">
                    <label class="form-label">Sector</label>
                    <input name="sector" type="text" value="@Model.Sector" class="form-control" />
                </div>
            </div>
            <div class="mt-3 d-flex justify-content-between">
                <button type="submit" class="btn btn-outline-success">Guardar Cambios</button>
                <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-danger">Cancelar</a>
            </div>
        </form>
    </div>
</div>
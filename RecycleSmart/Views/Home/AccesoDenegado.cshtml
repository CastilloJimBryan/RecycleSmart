@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_Layout";
    var tipoCuenta = Servicio.ManejosSesiones.ObtenerTipoCuenta(User);
}

<div class="text-center py-5">
    <h2>No Tiene permiso para esta sección</h2>
    <p class="text-muted">Consulte al administrador</p>
    <button type="button" class="btn btn-outline-dark" onclick="history.back()">Volver</button>
    <a a class="btn btn-success" asp-controller="@(tipoCuenta==TipoDeCuenta.EmpresaLogistica?"Dashboard":"PanelCentral")" asp-action="Index">Volver al inicio</a>
    @*<a asp-controller="@(tipoCuenta == TipoDeCuenta.EmpresaLogistica ? "Dashboard" : "PanelCentral")" asp-action="Index">Volver al Inicio</a>*@
</div>

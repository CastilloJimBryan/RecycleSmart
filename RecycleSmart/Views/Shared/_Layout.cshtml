<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/RecycleSmart.styles.css" asp-append-version="true" />
    <title>@ViewData["Title"] - RecycleSmart</title>
</head>
<body>
    @{
        var tipoCuenta = Servicio.ManejosSesiones.ObtenerTipoCuenta(User);
        var controllerActual = ViewContext.RouteData.Values["Controller"]?.ToString();
        string Activo(string c) => controllerActual == c ? "activo" : "";
    }
    <div class="wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside id="sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-logo">
                        <a asp-controller="@(tipoCuenta == TipoDeCuenta.EmpresaLogistica?"Dashboard":"PanelCentral")" asp-action="Index">RecycleSmart</a>
                        <p style="color: #85BC38;">IoT Compliance</p>
                    </div>
                    <button class="toggle-btn border-0" type="button">
                        <i id="icon" class='bx bx-chevrons-right'></i>
                    </button>
                </div>
                <ul class="sidebar-nav">
                    @if (tipoCuenta==TipoDeCuenta.EmpresaLogistica)
                    {

                        <li class="sidebar-item">
                            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @Activo("Dashboard")">
                                <i class='bx bxs-dashboard'></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse" data-bs-target="#miempresa" aria-expanded="false" aria-controls="miempresa">
                                <i class='bx bx-building-house'></i>
                                <span>Mi Empresa</span>
                            </a>
                        <ul id="miempresa" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                            <li class="sidebar-item">
                                <a asp-controller="UsuarioEmpresaLogistica" asp-action="Index" class="sidebar-link @Activo("UsuarioEmpresaLogistica")">
                                    <i class='bx bx-user'></i>
                                        <span>Usuario y Roles</span>
                                </a>
                            </li>

                            <li class="sidebar-item">
                                <a asp-controller="Suscripcion" asp-action="Index" class="sidebar-link @Activo("Suscripcion")">
                                    <i class='bx bx-wallet-alt'></i>
                                        <span>Suscripción / Plan</span>
                                </a>
                            </li>
                        </ul>
                         </li>

                        <li class="sidebar-item">
                            <a asp-controller="Institucion" asp-action="Index" class="sidebar-link @Activo("Institucion")">
                                <i class='bx bxs-institution'></i>
                                <span>Instituciones Cliente</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-controller="Contenedor" asp-action="Index" class="sidebar-link @Activo("Contenedor")">
                                <i class='bx bx-box'></i>
                                <span>Contenedores</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="mapa.html" class="sidebar-link">
                                <i class='bx bx-map-alt'></i>
                                <span>Mapa IoT</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="alertas.html" class="sidebar-link">
                                <i class='bx bx-bell'></i>
                                <span>Alertas</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse" data-bs-target="#rfid" aria-expanded="false" aria-controls="rfid">
                                <i class='bx bx-rfid'></i>
                                <span>RFID</span>
                            </a>
                            <ul id="rfid" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                                <li class="sidebar-item">
                                    <a asp-controller="UsuarioInstitucion" asp-action="Index" class="sidebar-link @Activo("UsuarioInstitucion")">
                                        <i class='bx bx-id-card'></i>
                                        <span>Tarjetas</span>
                                    </a>
                                </li>
                                <li class="sidebar-item">
                                    <a asp-controller="Evento" asp-action="Index" class="sidebar-link @Activo("Evento")">
                                        <i class='bx bx-log-in-circle'></i>
                                        <span>Log de Accesos</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link">
                                <i class='bx bx-line-chart'></i>
                                <span>Trazabilidad</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse" data-bs-target="#reporte" aria-expanded="false" aria-controls="reporte">
                                <i class='bx bxs-report'></i>
                                <span>Reportes</span>
                            </a>
                            <ul id="reporte" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                                <li class="sidebar-item">
                                    <a href="#" class="sidebar-link">
                                        <i class='bx bx-task'></i>
                                        <span>Auditoria</span>
                                    </a>
                                </li>
                                <li class="sidebar-item">
                                    <a href="#" class="sidebar-link">
                                        <i class='bx bx-file'></i>
                                        Historial de Eventos
                                    </a>
                                </li>
                                <li class="sidebar-item">
                                    <a href="#" class="sidebar-link">
                                        <i class='bx bx-clipboard'></i>
                                        Mensual
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link">
                                <i class='bx bx-bar-chart-square'></i>
                                <span>Compliance</span>
                            </a>
                        </li>

                    }
                    else
                    {
                        <li class="sidebar-item">
                            <a asp-controller="PanelCentral" asp-action="Index" class="sidebar-link @Activo("PanelCentral")">
                                <i class='bx bxs-dashboard'>
                                </i><span>Panel Central</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-controller="EmpresaLogistica" asp-action="Index" class="sidebar-link @Activo("EmpresaLogistica")">
                                <i class='bx bxs-truck'>
                                </i>
                                <span>Empresas Logisticas</span>
                            </a>
                        </li>
                    }
                </ul>
                <div class="sidebar-footer">
                    <a asp-controller="Login" asp-action="Salir" class="sidebar-link">
                        <i class='bx bx-log-out'></i>
                        <span>LogOut</span>
                    </a>
                </div>

            </aside>

            <div class="sidebar-overlay" id="sidebar-overlay"></div>

        }
        <div class="app-contenido">
            <header class="topbar">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="btn-menu-movil" type="button" id="btn-menu-movil" aria-label="Abrir Menu">
                        <i class="bx bx-menu"></i>
                    </button>
                }

            </header>

            <main class="app-main">
                @RenderBody()
            </main>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row text-body-secondary">
                        <div class="col-6 text-start">
                            <a href="#" class="text-body-secondary">
                                <strong>Empresa Cliente</strong>
                            </a>
                        </div>
                        <div class="col-6 text-end text-body-secondary d-none d-md-block">
                            <ul class="list-inline mb-0">
                                <li class="list-inline-item">
                                    <a href="#" class="text-body-secondary">_Contact</a>
                                </li>
                                <li class="list-inline-item">
                                    <a href="#" class="text-body-secondary">_Contact</a>
                                </li>
                                <li class="list-inline-item">
                                    <a href="#" class="text-body-secondary">_Contact</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
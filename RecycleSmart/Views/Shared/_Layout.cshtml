@{
    bool esAdmin = User.IsInRole(Roles.Administrador);
    bool verControl = User.TieneRol(Roles.Control);
}
<!DOCTYPE html> 
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
    <title>@ViewData["Title"] - RecycleSmart</title>
</head>
<body>
    @{
            var tipoCuenta = Servicio.ManejosSesiones.ObtenerTipoCuenta(User);
            var controllerActual = ViewContext.RouteData.Values["Controller"]?.ToString();
            var accionActual = ViewContext.RouteData.Values["Action"]?.ToString();
            string ActivoAccion(string c, string a) => controllerActual == c && accionActual == a ? "activo" : "";
            string Activo(string c) => controllerActual == c ? "activo" : "";
    } 
    <div class="wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside id="sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-logo">
                       <a asp-controller="@(tipoCuenta == TipoDeCuenta.EmpresaLogistica?"Dashboard":"PanelCentral")" asp-action="Index">Recycle Smart</a>
                        @* <a asp-controller="@(tipoCuenta == TipoDeCuenta.EmpresaLogistica?"Dashboard":"EmpresaLogistica")" asp-action="Index">Recycle Smart</a>*@
                        <p style="color: #85BC38;">IoT Compliance</p>
                    </div>
                    <button class="toggle-btn border-0" type="button">
                        <i id="icon" class='bx bx-chevrons-right'></i>
                    </button>
                </div>
                <ul class="sidebar-nav">
                    @if (tipoCuenta==TipoDeCuenta.EmpresaLogistica)
                    {
                        bool enUsuarioEmpresaLogistica = controllerActual == "UsuarioEmpresaLogistica";
                        bool enSuscripcion = controllerActual == "Suscripcion";
                        bool enUsuarioInstitucion = controllerActual == "UsuarioInstitucion";
                        bool enlogAcceso = controllerActual == "Acceso";
                        <li class="sidebar-item">
                            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @Activo("Dashboard")">
                                <i class='bx bxs-dashboard'></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        @if(esAdmin)
                        {
                      
                            <li class="sidebar-item">
                                <a href="#" class="sidebar-link collapsed has-dropdown" @(enUsuarioEmpresaLogistica || enSuscripcion ? "":"collapsed") data-bs-toggle="collapse" data-bs-target="#miempresa" aria-expanded="@(enUsuarioEmpresaLogistica || enSuscripcion ?"true":"false")" aria-controls="miempresa">
                                    <i class='bx bx-building-house'></i>
                                    <span>Mi Empresa</span>
                                </a>
                            <ul id="miempresa" class="sidebar-dropdown list-unstyled collapse @(enUsuarioEmpresaLogistica || enSuscripcion ? "show":"")" data-bs-parent="#sidebar">
                                <li class="sidebar-item">
                                    <a asp-controller="UsuarioEmpresaLogistica" asp-action="Index" class="sidebar-link @Activo("UsuarioEmpresaLogistica")">
                                        <i class='bx bx-user'></i>
                                            <span>Usuario y Roles</span>
                                    </a>
                                </li>

                                <li class="sidebar-item">
                                    <a asp-controller="Suscripcion" asp-action="Index" class="sidebar-link @Activo("Suscripcion")">
                                        <i class='bx bx-wallet-alt'></i>
                                            <span>Suscripción / Plan</span>
                                    </a>
                                </li>
                            </ul>
                             </li>
                         }
                        <li class="sidebar-item">
                            <a asp-controller="Institucion" asp-action="Index" class="sidebar-link @Activo("Institucion")">
                                <i class='bx bxs-institution'></i>
                                <span>Instituciones Cliente</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-controller="Contenedor" asp-action="Index" class="sidebar-link @Activo("Contenedor")">
                                <i class='bx bx-box'></i>
                                <span>Contenedores</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-controller="MapaIoT" asp-action="Index" class="sidebar-link @Activo("MapaIoT")">
                                <i class='bx bx-map-alt'></i>
                                <span>Mapa IoT</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-controller="Alertas" asp-action="Index" class="sidebar-link @Activo("Alertas")">
                                <i class='bx bx-bell'></i>
                                <span>Alertas</span>
                                @await Component.InvokeAsync("ContadorAlertas")
                            </a>
                        </li>
                        @if(verControl)
                        {   
                            <li class="sidebar-item">
                                    <a href="#" class="sidebar-link collapsed has-dropdown" @(enUsuarioInstitucion || enlogAcceso ? "" : "collapsed") data-bs-toggle="collapse" data-bs-target="#rfid" aria-expanded="@(enUsuarioInstitucion || enlogAcceso ? "true" : "false")" aria-controls="rfid">
                                    <i class='bx bx-rfid'></i>
                                    <span>RFID</span>
                                </a>
                                <ul id="rfid" class="sidebar-dropdown list-unstyled collapse @(enUsuarioInstitucion || enlogAcceso ? "show" : "")" data-bs-parent="#sidebar">
                                    <li class="sidebar-item">
                                        <a asp-controller="UsuarioInstitucion" asp-action="Index" class="sidebar-link @Activo("UsuarioInstitucion")">
                                            <i class='bx bx-id-card'></i>
                                            <span>Tarjetas</span>
                                        </a>
                                    </li>
                                    <li class="sidebar-item">
                                        <a asp-controller="Acceso" asp-action="Index" class="sidebar-link @Activo("Acceso")">
                                            <i class='bx bx-log-in-circle'></i>
                                            <span>Log de Accesos</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            
                        }
                        <li class="sidebar-item">
                            <a asp-controller="Trazabilidad" asp-action="Index" class="sidebar-link">
                                <i class='bx bx-line-chart'></i>
                                <span>Trazabilidad</span>
                            </a>
                        </li>
                        @if(verControl)
                        {
                                
                            <li class="sidebar-item">
                                <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse" data-bs-target="#reporte" aria-expanded="false" aria-controls="reporte">
                                    <i class='bx bxs-report'></i>
                                    <span>Reportes</span>
                                </a>
                                <ul id="reporte" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                                    <li class="sidebar-item">
                                        <a href="#" class="sidebar-link">
                                            <i class='bx bx-task'></i>
                                            <span>Auditoria</span>
                                        </a>
                                    </li>
                                    <li class="sidebar-item">
                                        <a href="#" class="sidebar-link">
                                            <i class='bx bx-file'></i>
                                            Historial de Eventos
                                        </a>
                                    </li>
                                    <li class="sidebar-item">
                                        <a href="#" class="sidebar-link">
                                            <i class='bx bx-clipboard'></i>
                                            Mensual
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if(verControl)
                        {
                                
                            <li class="sidebar-item">
                                <a asp-controller="Compliance" asp-action="Index" class="sidebar-link @Activo("Compliance")">
                                    <i class='bx bx-bar-chart-square'></i>
                                    <span>Compliance</span>
                                </a>
                            </li>
                            }

                        }
                        else
                        {
                            bool enEmpresa = controllerActual == "EmpresaLogistica";
                        <li class="sidebar-item">
                            <a asp-controller="PanelCentral" asp-action="Index" class="sidebar-link @Activo("PanelCentral")">
                                <i class='bx bxs-dashboard'>
                                </i><span>Panel Central</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link has-dropdown @(enEmpresa ? "":"collapsed")" data-bs-toggle="collapse" data-bs-target="#empresas" 
                            aria-expanded="@(enEmpresa?"true":"false")" aria-controls="empresas">
                                <i class='bx bxs-truck'>
                                </i>
                                <span>Empresas Logisticas</span>
                            </a>
                            <ul id="empresas" class="sidebar-dropdown list-unstyled collapse @(enEmpresa? "show":"")" data-bs-parent="#sidebar">
                                <li class="sidebar-item">
                                    <a asp-controller="EmpresaLogistica" asp-action="Registrar" class="sidebar-link @ActivoAccion("EmpresaLogistica", "Registrar")"> <i class='bx bx-buildings'></i><span>Registrar Empresa</span></a>
                                </li>
                                <li class="sidebar-item">
                                    <a asp-controller="EmpresaLogistica" asp-action="Index" class="sidebar-link @(enEmpresa && accionActual != "Registrar" ? "activo" : "")"><i class='bx bx-building'></i><span>Gestionar Empresa</span></a>
                                </li>
                            </ul>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link">
                                <i class="bx bx-book-content"></i><span>Normativa</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link">
                                <i class="bx bx-receipt"></i><span>Facturacion</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link">
                                <i class="bx bx-support"></i><span>Soporte IoT</span>
                            </a>
                        </li>
                    }
                </ul>
                <div class="sidebar-footer">
                    <a asp-controller="Login" asp-action="Salir" class="sidebar-link">
                        <i class='bx bx-log-out'></i>
                        <span>LogOut</span>
                    </a>
                </div>

            </aside>

            <div class="sidebar-overlay" id="sidebar-overlay"></div>

        }
        <div class="app-contenido">
            <header class="topbar">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="btn-menu-movil" type="button" id="btn-menu-movil" aria-label="Abrir Menu">
                        <i class="bx bx-menu"></i>
                    </button>
                }

            </header>

            <main class="app-main">
                @RenderBody()
            </main>
            @{
                    string pie = "";
                    if(User.Identity?.IsAuthenticated==true)
                    {
                        pie = tipoCuenta == "EmpresaLogistica" ? ManejosSesiones.ObtenerEmpresaNombre(User) : "Panel Recycle Smart";
                    }
                }
            <footer class="footer small text-muted">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <span>@pie</span>
                    <span>Recycle Smart © @DateTime.Now.Year</span>
                </div>
            </footer>
        </div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="contenedor-avisos"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>


    @if (tipoCuenta == TipoDeCuenta.EmpresaLogistica)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script src="~/js/monitoreo.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model RecycleSmart.Models.EmpresaDetalleViewModel

@{
    var e = Model.Empresa;
    var estado = e.Estados.ToString();
    ViewData["Title"] = $"Empresa{e.Nombre}";

    var usos = new[]
    {
        (Titulo:"Instituciones",Usado:Model.Uso?.Instituciones??0,Max:Model.Uso?.MaxInstituciones??0),
        (Titulo:"Contenedores",Usado:Model.Uso?.Contenedores??0,Max:Model.Uso?.MaxContenedores??0),
    };
    string Hace(DateTime? f)
    {
        if(f==null)
        {
            return "No hay Datos";
        }
        var d = DateTime.Now - f.Value;
        return d.TotalMinutes < 60 ? $"Hace {(int)d.TotalMinutes} min " : d.TotalHours < 24 ? $"Hace {(int)d.TotalHours} h " : $"Hace {(int)d.TotalDays} dias";
    }


    var ar = new System.Globalization.CultureInfo("es-AR");
    string Usd(decimal monto) => "US$ " + monto.ToString("N2", ar);
    bool enMora = Model.Facturas.Any(f => f.MoraGrave);
    var peorFactura = Model.Facturas.Where(f => f.MoraGrave).OrderByDescending(f => f.DiasVencida).FirstOrDefault();

    string EstadoTexto(RecycleSmartBE.Factura f) =>
        f.EstadoFactura == TipoEstado.EstadoFactura.Pagada ? "Pagada"
        : f.Vencida ? $"Vencida ({f.DiasVencida} {(f.DiasVencida == 1 ? "día" : "días")})"
        : "Pendiente";
}
<partial name="_Mensajes"/>
<div class="mb-4">
    <a class="btn btn-theme-success btn-sm" asp-action="Index">
        <i class="bx bx-arrow-from-right btn-sm"></i> Volver al Listado
    </a>
</div>
    <div class="d-flex justify-content-between align-items-center mb-3">
         <h2 class="mb-1">@e.Nombre</h2>    
         <span class="badge @EstadosColor.EstadoBadge(estado)">@estado</span>

    </div>
@if(!Model.TieneAdministrador && e.Estados!=TipoEstado.Estados.Baja)
{
    <div class="alert-info d-flex justify-content-between align-items-center mb-3">
        <span>Aun No tiene Administrador</span>
        <a asp-action="CrearAdmin" asp-route-id="@e.Id" class="btn btn-outline-dark btn-sm">Crear Administrador</a>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold">Datos de la Empresa</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="fw-semibold">CUIT</div>
                        <div class="text-muted small">@($"{e.Cuit[..2]}-{e.Cuit[2..10]}-{e.Cuit[10]}")</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-semibold">Plan</div>
                        <div class="text-muted small">@e.PlanNombre</div>
                        
                    </div>
                    <div class="col-6">
                        <div class="fw-semibold">Fecha Registro</div>
                        <div class="text-muted small">@e.FechaRegistro.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-semibold">Direccion</div>
                        <div class="text-muted small">@e.Direccion</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold">Uso del Plan @e.PlanNombre</div>
            <div class="card-body">
                @foreach (var item in usos)
                {
                    var ilimitado = item.Max == 0;
                    var porcentaje = ilimitado ? 100 : Math.Min(100, item.Usado * 100 / item.Max);
                    var color = ilimitado ? "bg-info" : porcentaje >= 90 ? "bg-danger" : porcentaje >= 70 ? "bg-warning" : "bg-success";
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>@item.Titulo</span>
                            <span>@item.Usado/@(ilimitado?"Ilimitado":item.Max.ToString())</span>
                        </div>
                        <div class="progress" style="height:10px">
                            <div class="progress-bar @color" style="@($"width:{porcentaje}%")" ></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">Usuarios de la Empresa</div>
    <div class="card-body">
        @if (Model.Usuarios.Count == 0)
        {
            <p class="text-muted p-3 mb-0">La empresa no tiene usuarios</p>
        }
        else
        {
            <table class="table table-bordered table-striped mb-0">
                <thead class="table table-success">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Usuarios)
                    {
                        var colorestado = item.Estados.ToString();
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Apellido</td>
                            <td>@item.Correo</td>
                            <td>@item.Rol</td>
                            <td><span class="badge @EstadosColor.EstadoBadge(colorestado)">@item.Estados</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold d-flex justify-content-between align-items-center">
        <span>Dispositivos IoT con problemas</span>
        @if (Model.DispositivosOffline.Count > 0)
        {
            <span class="badge bg-danger">@Model.DispositivosOffline.Count sin conexión</span>
        }
    </div>
    <div class="card-body p-0">
        @if (Model.DispositivosOffline.Count == 0)
        {
            <p class="text-success fw-semibold p-3 mb-0">Todos los dispositivos de la empresa están conectados.</p>
        }
        else
        {
            <table class="table table-striped mb-0">
                <thead>
                    <tr><th>Contenedor</th><th>Institución</th><th>MAC</th><th>Última lectura</th><th>Desconectado</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DispositivosOffline)
                    {
                        <tr>
                            <td>@d.ContenedorNombre</td>
                            <td>@d.InstitucionNombre</td>
                            <td><code>@d.MacAddress</code></td>
                            <td class="text-nowrap">@(d.UltimaLectura?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td class="text-danger">@Hace(d.UltimaLectura)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">Facturación</div>
    <div class="card-body p-0">
        @if (Model.Facturas.Count == 0)
        {
            <p class="text-muted p-3 mb-0">La empresa todavía no tiene facturas emitidas.</p>
        }
        else
        {
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Período</th>
                        <th>Monto</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                        <th>Pago</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Facturas)
                    {
                        <tr class="@(f.MoraGrave ? "table-danger" : "")">
                            <td><code>@f.Numero</code></td>
                            <td>@f.Periodo</td>
                            <td>@Usd(f.Monto)</td>
                            <td>@f.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge @EstadosColor.EstadoBadge(f.EstadoFactura.ToString())">@EstadoTexto(f)</span></td>
                            <td>@(f.FechaPago?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-center">
                                @if (f.EstadoFactura == TipoEstado.EstadoFactura.Pendiente)
                                {
                                    <form asp-controller="Facturacion" asp-action="RegistrarPago" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@f.Id" />
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                        <button type="submit" class="btn btn-theme-success btn-sm"><i class="bx bx-wallet"></i> Registrar pago</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (enMora && e.Estados == TipoEstado.Estados.Activo && peorFactura != null)
{
    <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>
            <strong>Pago vencido:</strong> la factura @peorFactura.Numero tiene @peorFactura.DiasVencida días de vencida.
            Se sugiere suspender la empresa.
        </span>
        <button type="button" class="btn btn-danger btn-sm"
                onclick="document.getElementById('nota').value='Suspensión por falta de pago: factura @peorFactura.Numero vencida hace @peorFactura.DiasVencida días.'; document.getElementById('nota').focus();">
            Preparar suspensión
        </button>
    </div>
}

@if(e.Estados!=TipoEstado.Estados.Baja)
{  
    <div class="d-flex justify-content-center">
        <div class="card" style="width:100%; max-width:560px">
            <div class="card-header fw-bold d-flex justify-content-between align-items-center">
                <span>Acciones</span>
                <a asp-action="Editar" asp-route-id="@e.Id" class="btn btn-outline-secondary btn-sm"><i class="bx bx-pencil"></i> Editar</a>
            </div>
            <div class="card-body">
                 <form asp-action="CambiarEstado" method="post">
                    <input type="hidden" name="id" value="@e.Id" />
                    <label class="form-label small text-muted" for="nota" >Nota Justificacion</label>
                    <textarea id="nota" name="nota" class="form-control mb-3" rows="2" required minlength="15" maxlength="100" placeholder="Ejemplo tiene pagos vencidos"></textarea>
                    <div class="d-flex justify-content-end gap-2">
                        @if(e.Estados==TipoEstado.Estados.Activo)
                            {
                            <button name="estado" value="Suspendido" class="btn btn-outline-warning btn-sm"><i class="bx bx-pause"></i>Suspender</button>
                            }
                            else
                            {
                            <button name="estado" value="Activo" class="btn btn-outline-success btn-sm"><i class="bx bx-play"></i>Reactivar</button>
                            }
                        <button name="estado" value="Baja" class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Dar de baja a @e.Nombre? Esta acción no se puede deshacer.');"> <i class="bx bx-x"></i> Dar de Baja</button>
                    </div>
                </form>  
            </div>
        </div>
    </div>
}

<div class="card mt-3">
    <div class="card-header fw-bold">Historial de auditoría</div>
    <div class="card-body p-0">
        @if (Model.Auditoria.Count == 0)
        {
            <p class="text-muted p-3 mb-0">Todavía no hay acciones registradas para esta empresa.</p>
        }
        else
        {
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Acción</th>
                        <th>Cambio</th>
                        <th>Nota</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Auditoria)
                    {
                        <tr>
                            <td class="text-nowrap">@a.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@a.Accion</td>
                            <td class="text-nowrap">@a.EstadoAnterior → @a.EstadoNuevo</td>
                            <td>@a.Nota</td>
                            <td class="text-nowrap">@a.UsuarioNombre</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
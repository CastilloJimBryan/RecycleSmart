@model List<RecycleSmartBE.EmpresaLogistica>

@{
    ViewData["Title"] = "Empresas Logisticas";
}
<div class="align-items-center mb-3">
<h2>Listado de Empresas Logisticas</h2>
    <div>
        <a asp-action="Registrar" class="btn btn-success btn-sm">Registrar Nueva Empresa </a>
    </div>
</div>

<partial name="_Mensajes"/>

@if(Model.Count==0)
{
    <div class="alert alert-info">Todavia no hay empresas Registradas</div>
} 
else
{
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-success">
                    <tr>
                        <th>Nombre</th>
                        <th>CUIT</th>
                        <th>Direccion</th>
                        <th>Fecha Registro</th>
                        <th>Plan</th>
                        <th>Estado</th>
                        <th>Administrador</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var estado = item.Estados.ToString();
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@($"{item.Cuit[..2]}-{item.Cuit[2..10]}-{item.Cuit[10]}")</td>
                            <td>@item.Direccion</td>
                            <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>@item.PlanNombre</td>
                            <td>
                                <span class="badge @EstadosColor.EstadoBadge(estado)">@estado</span>
                            </td>
                            <td>
                                @if(item.AdminNombre!=null)
                            {
                                @item.AdminNombre
                            }
                            else
                            {
                                <span class="badge bg-secondary text-dark">Sin Administrador</span>
                            }
                        </td>
                            <td>
                            <a asp-action="Detalle" asp-route-id="@item.Id" class="btn  btn-theme-success btn-sm"> <i class="bx bx-show"></i> Ver </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
}
            
@model List<RecycleSmartBE.EmpresaLogistica>

@{
    ViewData["Title"] = "Empresas Logisticas";
}
<h2>Listado de Empresas Logisticas</h2>

@if(TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" >
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if(Model.Count==0)
{
    <div class="alert alert-info">Todavia no hay empresas registradas</div>
} 
else
{
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-success">
                    <tr>
                        <th>Nombre</th>
                        <th>CUIT</th>
                        <th>Direccion</th>
                        <th>Fecha Registro</th>
                        <th>Plan</th>
                        <th>Estado</th>
                        <th>Administrador</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var estado = item.Estados.ToString();
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@($"{item.Cuit[..2]}-{item.Cuit[2..10]}-{item.Cuit[10]}")</td>
                            <td>@item.Direccion</td>
                            <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>@item.PlanNombre</td>
                            <td>
                                <span class="badge @EstadosColor.EstadoBadge(estado)">@estado</span>
                            </td>
                            <td>
                                sin admin
                            </td>
                            <td>
                            <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-theme-success">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
}
            <div>
                <a asp-action="Registrar" class="btn btn-success">Registrar Nueva Empresa </a>
            </div>
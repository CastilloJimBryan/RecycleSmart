@model EmpresaLogistica

@{
    ViewData["Title"] = "Registrar Empresa";
}

<h2>Registrar Empresa Logistica</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Registrar" method="post">
            <partial name="_Formulario" model="Model"/>
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-outline-success">Registrar Empresa</button>
                <a asp-action="Index" class="btn btn-outline-danger">Cancelar</a>
            </div>
        </form>
    </div>
</div>